# ─────────────────────────────────────────────────────────────────────────────
# CONTABDSI — entorno del contenedor (copiar a docker/.env y editar)
#
#   cp docker/.env.example docker/.env
#
# Este archivo NO se versiona (docker/.gitignore). No uses valores de ejemplo
# en producción.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio público ─────────────────────────────────────────────────────────
# Debe existir un registro DNS A → IP pública del servidor.
# El same-origin sirve la SPA y la API en el mismo host (no hace falta un
# subdominio api.*).
HOST_APP=contabilidad.jcti.xyz
ACME_EMAIL=admin@jcti.xyz

# ── Modo TLS ────────────────────────────────────────────────────────────────
# Edge compartido (recomendado en dsi-vps, donde edge_caddy ya ocupa 80/443):
#   TLS=false, ALLOW_INSECURE=true, PUBLIC_SCHEME=https
# Modo directo (este contenedor es el único que publica 80/443):
#   TLS=true y PUBLIC_HTTP_PORT=80 / PUBLIC_HTTPS_PORT=443
TLS=false
ALLOW_INSECURE=true
PUBLIC_SCHEME=https

# ── Puertos publicados en el host (loopback) ────────────────────────────────
# Propios de contabilidad; no reutilizar 30180/30181 (ecommerce) ni
# 30280/30281 (CRM).
PUBLIC_HTTP_PORT=127.0.0.1:30380
PUBLIC_HTTPS_PORT=127.0.0.1:30381

# Puertos internos del contenedor (normalmente no cambian).
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Motor de datos ──────────────────────────────────────────────────────────
# Advantage (ADS/OLEDB) es Windows-only; en el contenedor usa PostgreSQL.
CONTABDSI_STORE=postgres
# Con la BD incluida en el compose (perfil "db"), el host es `db`.
# La base migrada se llama `contabdsi_datos` (ver docker/restore-db.ps1).
DATABASE_URL=postgres://contabdsi:CAMBIAR_CLAVE@db:5432/contabdsi_datos

# ── PostgreSQL incluido (perfil "db") ─────────────────────
POSTGRES_USER=contabdsi
POSTGRES_PASSWORD=CAMBIAR_CLAVE
# Base destino de los datos migrados (no usar la demo `contabdsi`).
POSTGRES_DB=contabdsi_datos
# true ⇒ incluye db/postgresql/seed.sql (datos de demostración 001/NOM2).
# En producción déjalo en false y restaura los datos reales migrados.
WITH_SEED=false

# ── Asistente contable (ia-service / DeepSeek) ──────────────────────────────
IA_SERVICE_DEEPSEEK_API_KEY=
# Respaldo si se comparte una sola clave entre servicios.
DEEPSEEK_API_KEY=

# ── Acceso (AccessGate / Fortuner27) ────────────────────────────────────────
# El backend debe poder alcanzar la API de Fortuner desde el contenedor.
#   - Fortuner en el host Windows: http://host.docker.internal:8004
#   - Fortuner como contenedor:    http://<nombre-del-contenedor>:8004
FORTUNER_API_URL=http://host.docker.internal:8004
# Cookie de sesión Secure: obligatorio detrás de HTTPS (mode edge o directo).
CONTABDSI_COOKIE_SECURE=true
# URL pública de Fortuner que muestra el botón "Ir a FORTUNER27".
# Se hornea en el bundle: cambiarla exige `docker compose build`.
VITE_FORTUNER_URL=https://fortuner.jcti.xyz/

# ── Endurecimiento opcional ─────────────────────────────────────────────────
# Basic Auth exterior en TODA la app. Viene desactivado porque AccessGate ya
# exige autorización de Fortuner o clave administrativa; actívalo si expones
# el sitio sin Fortuner o quieres una barrera adicional.
PROTECT_APP=false
APP_USER=admin
APP_PASSWORD=
APP_PASSWORD_HASH=

# Límite de cuerpo en Caddy (importaciones XLSX). "0" = sin límite.
MAX_REQUEST_BODY=50MB

# Política CSP. Vacío/off = sin cabecera; por defecto se aplica una política
# segura para la SPA.
# CSP_POLICY=

# Orígenes que pueden embeber la app en un iframe.
# 'self' = solo el mismo origen (protección anti-clickjacking).
# Si Fortuner27 muestra el módulo dentro de un iframe, añade su origen:
#   FRAME_ANCESTORS='self' https://fortuner.jcti.xyz
# En ese caso el generador omite X-Frame-Options y deja la restricción en CSP.
FRAME_ANCESTORS='self'
