# Clave de DeepSeek dedicada al asistente contable. Si se omite, el servicio usa
# DEEPSEEK_API_KEY como respaldo.
IA_SERVICE_DEEPSEEK_API_KEY=sk-7aecdc1b239c4f649e8ff0ae3f886ec2

# Modelo y endpoint.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com

# API del backend de CONTABDSI. El asistente no consulta la base de datos: llama
# a estos endpoints (los handlers usan app/backend.py).
BACKEND_API_URL=http://127.0.0.1:8001
BACKEND_TIMEOUT=30

# Tiempo de vida (segundos) de la caché del catálogo de cuentas.
IA_SERVICE_CATALOG_TTL=300

# Puerto del servicio. Vite lo consume por el proxy /bot-api (ver vite.config.ts).
IA_SERVICE_PORT=8003

# Orígenes permitidos por CORS (separados por coma); solo aplica si el widget
# llama al servicio sin pasar por el proxy de Vite.
CORS_ORIGIN=http://localhost:8443
