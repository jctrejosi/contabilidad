# Clave de DeepSeek dedicada al asistente contable. Si se omite, el servicio usa
# DEEPSEEK_API_KEY como respaldo.
IA_SERVICE_DEEPSEEK_API_KEY=

# Modelo y endpoint.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com

# Puerto del servicio. Vite lo consume por el proxy /bot-api (ver vite.config.ts).
IA_SERVICE_PORT=8003

# Backend de CONTABDSI al que el asistente pide los datos por HTTP (fase 0). El
# puerto por defecto es el que levanta dev.js para backend/; el asistente nunca
# se conecta a la base de datos.
IA_SERVICE_BACKEND_URL=http://localhost:8001

# Tiempo de espera (segundos) de las peticiones al backend.
IA_SERVICE_BACKEND_TIMEOUT=30

# Orígenes permitidos por CORS (separados por coma); solo aplica si el widget
# llama al servicio sin pasar por el proxy de Vite.
CORS_ORIGIN=http://localhost:8443
